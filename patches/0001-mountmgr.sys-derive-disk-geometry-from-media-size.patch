From: delirus <realdelirus@gmail.com>
Subject: [PATCH] mountmgr.sys: Derive the disk geometry from the actual media size.

IOCTL_DISK_GET_DRIVE_GEOMETRY and IOCTL_DISK_GET_DRIVE_GEOMETRY_EX return a
hardcoded cylinder count of 10000, so every disk is reported as
10000 * 255 * 63 * 512 = 82,321,920,000 bytes, regardless of its real size.
That contradicts the size reported everywhere else - Win32_DiskDrive.Size,
IOCTL_VOLUME_GET_VOLUME_DISK_EXTENTS, GetDiskFreeSpaceEx - and software that
cross-checks the two rejects the machine as tampered with.

Derive the cylinder count from the media size instead.  \Device\HarddiskN has
neither a unix device nor a mount point of its own, so fall back to the disk
behind drive C:.  The raw device size is read from /sys/class/block/<name>/size
because /dev/<name> is usually only readable by group "disk".

SPDX-License-Identifier: LGPL-2.1-or-later (like Wine itself, see COPYING.LGPL-2.1)

---
--- a/dlls/mountmgr.sys/device.c
+++ b/dlls/mountmgr.sys/device.c
@@ -1840,6 +1840,49 @@
     return status;
 }
 
+/* Return the size of the media behind a single disk device, or 0. */
+static LONGLONG get_disk_device_size( struct disk_device *dev )
+{
+    struct size_info size_info = { 0, 0, 0, 0, 0 };
+    struct get_volume_size_info_params params = { dev->unix_mount, &size_info };
+    UINT64 raw = 0;
+    struct get_device_size_params dev_params = { dev->unix_device, &raw };
+
+    if (dev->unix_device && MOUNTMGR_CALL( get_device_size, &dev_params ) == STATUS_SUCCESS && raw)
+        return raw;
+    if (!dev->unix_mount) return 0;
+    if (MOUNTMGR_CALL( get_volume_size_info, &params ) != STATUS_SUCCESS) return 0;
+    return size_info.total_allocation_units * size_info.sectors_per_allocation_unit
+           * size_info.bytes_per_sector;
+}
+
+/* Return the total size of the media behind a disk device, or 0. */
+static LONGLONG get_device_total_size( struct disk_device *dev )
+{
+    struct dos_drive *drive;
+    LONGLONG size;
+
+    if ((size = get_disk_device_size( dev ))) return size;
+
+    /* \Device\HarddiskN has neither a unix device nor a mount point of its
+     * own.  Windows reports the size of the physical disk the system drive
+     * lives on, so fall back to drive C:, then to any drive we can measure. */
+    LIST_FOR_EACH_ENTRY( drive, &drives_list, struct dos_drive, entry )
+    {
+        if (drive->drive != 2) continue;  /* 2 == C: */
+        if (drive->volume && drive->volume->device &&
+            (size = get_disk_device_size( drive->volume->device )))
+            return size;
+    }
+    LIST_FOR_EACH_ENTRY( drive, &drives_list, struct dos_drive, entry )
+    {
+        if (drive->volume && drive->volume->device &&
+            (size = get_disk_device_size( drive->volume->device )))
+            return size;
+    }
+    return 0;
+}
+
 /* handler for ioctls on the harddisk device */
 static NTSTATUS WINAPI harddisk_ioctl( DEVICE_OBJECT *device, IRP *irp )
 {
@@ -1860,12 +1903,16 @@
     {
         DISK_GEOMETRY info;
         DWORD len = min( sizeof(info), irpsp->Parameters.DeviceIoControl.OutputBufferLength );
+        /* Derive the cylinder count from the actual media size.  With a
+         * fixed value every disk reports the same 82 GB, which contradicts
+         * the size reported by Win32_DiskDrive and by the volume APIs. */
+        LONGLONG total = get_device_total_size( dev );
 
-        info.Cylinders.QuadPart = 10000;
         info.MediaType = (dev->devnum.DeviceType == FILE_DEVICE_DISK) ? FixedMedia : RemovableMedia;
         info.TracksPerCylinder = 255;
         info.SectorsPerTrack = 63;
         info.BytesPerSector = 512;
+        info.Cylinders.QuadPart = total ? total / (255LL * 63 * 512) : 10000;
         memcpy( irp->AssociatedIrp.SystemBuffer, &info, len );
         irp->IoStatus.Information = len;
         status = STATUS_SUCCESS;
@@ -1878,7 +1925,10 @@
 
         FIXME("The DISK_PARTITION_INFO and DISK_DETECTION_INFO structures will not be filled\n");
 
-        info.Geometry.Cylinders.QuadPart = 10000;
+        {
+            LONGLONG total = get_device_total_size( dev );
+            info.Geometry.Cylinders.QuadPart = total ? total / (255LL * 63 * 512) : 10000;
+        }
         info.Geometry.MediaType = (dev->devnum.DeviceType == FILE_DEVICE_DISK) ? FixedMedia : RemovableMedia;
         info.Geometry.TracksPerCylinder = 255;
         info.Geometry.SectorsPerTrack = 63;
--- a/dlls/mountmgr.sys/unixlib.c
+++ b/dlls/mountmgr.sys/unixlib.c
@@ -344,6 +344,52 @@
 }
 #endif
 
+/* Return the size of a block device in bytes. */
+static NTSTATUS get_device_size( void *args )
+{
+    const struct get_device_size_params *params = args;
+    const char *name;
+    char path[256], buf[64];
+    ssize_t len;
+    off_t size;
+    int fd;
+
+    *params->size = 0;
+    if (!params->unix_device) return STATUS_NO_SUCH_DEVICE;
+
+    /* Try sysfs first: /dev/<name> is usually only readable by group "disk",
+     * while /sys/class/block/<name>/size is world readable.  The value there
+     * is the number of 512 byte sectors. */
+    if ((name = strrchr( params->unix_device, '/' ))) name++;
+    else name = params->unix_device;
+    if (*name)
+    {
+        snprintf( path, sizeof(path), "/sys/class/block/%s/size", name );
+        if ((fd = open( path, O_RDONLY )) != -1)
+        {
+            len = read( fd, buf, sizeof(buf) - 1 );
+            close( fd );
+            if (len > 0)
+            {
+                buf[len] = 0;
+                size = (off_t)strtoull( buf, NULL, 10 ) * 512;
+                if (size > 0)
+                {
+                    *params->size = size;
+                    return STATUS_SUCCESS;
+                }
+            }
+        }
+    }
+
+    if ((fd = open( params->unix_device, O_RDONLY )) == -1) return errno_to_status( errno );
+    size = lseek( fd, 0, SEEK_END );
+    close( fd );
+    if (size <= 0) return STATUS_INVALID_DEVICE_REQUEST;
+    *params->size = size;
+    return STATUS_SUCCESS;
+}
+
 static NTSTATUS get_volume_size_info( void *args )
 {
     const struct get_volume_size_info_params *params = args;
@@ -632,6 +678,7 @@
     write_credential,
     delete_credential,
     enumerate_credentials,
+    get_device_size,
 };
 
 C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
--- a/dlls/mountmgr.sys/unixlib.h
+++ b/dlls/mountmgr.sys/unixlib.h
@@ -80,6 +80,14 @@
     struct size_info *info;
 };
 
+/* Raw size of a block device, used for the geometry of \Device\HarddiskN
+ * which has no mount point of its own. */
+struct get_device_size_params
+{
+    const char *unix_device;
+    UINT64 *size;
+};
+
 struct get_dosdev_symlink_params
 {
     const char *dev;
@@ -173,6 +181,7 @@
     unix_write_credential,
     unix_delete_credential,
     unix_enumerate_credentials,
+    unix_get_device_size,
     unix_funcs_count
 };
 
